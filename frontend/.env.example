# Backend API origin (no trailing slash, no /api/v1).
# Local: http://localhost:4000
# Production (Render): https://your-backend.onrender.com
BACKEND_URL=http://localhost:4000

# WebSocket / Socket.io URL (browser). Same as backend origin in production.
# Next.js embeds this at build time; set in Vercel Environment Variables.
NEXT_PUBLIC_WS_URL=

# Voice interview server URL (browser). Same as backend origin in production.
NEXT_PUBLIC_API_URL=
