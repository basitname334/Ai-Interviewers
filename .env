# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# PostgreSQL - use the same user/password you use for createdb -U postgres (default user is "postgres")
DATABASE_URL=postgresql://postgres:zain347@localhost:5432/ai_interviewer

# Redis (sessions, context, Bull)
REDIS_URL=redis://localhost:6379

# Ollama Configuration (Local LLM) – used when OPENROUTER_API_KEY is not set
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=500

# Open Router – when set, interviewer (voice + chat) uses Open Router for role-based questions
OPENROUTER_API_KEY=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
OPENROUTER_MODEL=openai/gpt-4o-mini

# AICC API (optional)
AICC_API_KEY=sk-1FYfVIdmfiQNOuRnEOlWBOIahSQfVWLzLPux6Yxu3p8zuwdj

# Whisper Configuration (Local Speech-to-Text)
WHISPER_MODEL=base.en
